{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "InkKeep 主視窗需要的權限。Tauri 2 預設拒絕所有 plugin 指令，要在這裡逐項開。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "dialog:allow-open",
    "notification:default"
  ]
}
